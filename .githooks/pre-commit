#!/bin/bash
# Pre-commit: 语法检查 + 禁止新增敏感文件
FAILED=0
PYTHON_BIN="${PYTHON_BIN:-python3.12}"
command -v "$PYTHON_BIN" &>/dev/null || PYTHON_BIN="python3"

# 1. 语法检查 — 只检查新增/修改的 .py 文件
changed_py=$(git diff --cached --name-only --diff-filter=ACM | grep '\.py$' || true)
if [ -n "$changed_py" ]; then
    echo "$changed_py" | while read f; do
        [ -f "$f" ] || continue
        $PYTHON_BIN -c "import py_compile; py_compile.compile('$f', doraise=True)" 2>/dev/null || {
            echo "❌ 语法错误: $f"; FAILED=1; }
    done
fi

# 2. 禁止新增敏感文件（只检查新增A，不检查删除D/修改M）
blocked=$(git diff --cached --name-only --diff-filter=A | grep -E '\.env$|\.pem$|credentials\.json$|secret|settings\.json$|stores\.json$' || true)
[ -n "$blocked" ] && echo "⛔ 禁止提交密钥文件: $blocked" && FAILED=1

# 3. 禁止新增构建产物/中间产物（.c 中间产物、tar.gz/zip、_native 二进制）
blocked_artifacts=$(git diff --cached --name-only --diff-filter=A | grep -E '\.c$|\.tar\.gz$|\.zip$|auth_cache\.json$|/_native/' || true)
[ -n "$blocked_artifacts" ] && echo "⛔ 禁止提交构建产物/中间产物: $blocked_artifacts" && FAILED=1

# 4. 禁止新增 skill/data 运行时数据（*.example 模板豁免）
blocked_runtime=$(git diff --cached --name-only --diff-filter=A | grep -E '^skill/data/' | grep -v '\.example$' || true)
[ -n "$blocked_runtime" ] && echo "⛔ 禁止提交 skill/data 运行时数据: $blocked_runtime" && FAILED=1

[ $FAILED -ne 0 ] && echo "❌ Pre-commit 失败。bash scripts/ci.sh --quick" && exit 1
echo "✅ Pre-commit 通过"
