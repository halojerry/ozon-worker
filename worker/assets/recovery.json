{"name": "pounding-ozon-recovery", "nodes": [{"id": "cron", "name": "Every30s", "type": "n8n-nodes-base.scheduleTrigger", "typeVersion": 1.1, "position": [200, 300], "parameters": {"rule": {"interval": [{"field": "seconds", "secondsInterval": 30}]}}}, {"id": "query", "name": "QueryPending", "type": "n8n-nodes-base.code", "typeVersion": 1, "position": [400, 300], "parameters": {"jsCode": "const SB_URL='https://kekmppsuiiokdckdeolv.supabase.co';const SB_KEY='process.env.SUPABASE_SERVICE_ROLE_KEY||''';const cutoff=new Date(Date.now()-5*60*1000).toISOString();try{const resp=await this.helpers.httpRequest({method:'GET',url:SB_URL+'/rest/v1/gateway_tasks?select=task_id&status=eq.pending&created_at=lt.'+encodeURIComponent(cutoff)+'&limit=5',headers:{apikey:SB_KEY,Authorization:'Bearer '+SB_KEY},json:true,timeout:10000});const tasks=resp||[];return tasks.map(function(t){return{json:{task_id:t.task_id}})};}catch(e){return[]}"}}, {"id": "resubmit", "name": "Resubmit", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [600, 300], "parameters": {"method": "POST", "url": "https://worker.mxou.cn/webhook/pl-v3-304140", "authentication": "none", "sendHeaders": true, "headerParameters": {"parameters": [{"name": "Content-Type", "value": "application/json"}]}, "sendBody": true, "specifyBody": "json", "jsonBody": "={{ JSON.stringify({task_id: $json.task_id, recovery: true}) }}", "options": {"timeout": 10000}}}], "connections": {"Every30s": {"main": [[{"node": "QueryPending", "type": "main", "index": 0}]]}, "QueryPending": {"main": [[{"node": "Resubmit", "type": "main", "index": 0}]]}}, "settings": {"executionOrder": "v1"}}