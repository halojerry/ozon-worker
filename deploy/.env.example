# ─── Worker 环境变量模板 ───
# 复制为 .env 并填入实际值

# PostgreSQL 连接串（必填）
PGDATABASE_URL=postgresql://postgres:your_password@postgres:5432/ozon

# Supabase 鉴权（生产环境必填，本地可留空跳过鉴权）
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_service_role_key

# 应用配置
APP_WORKSPACE_PATH=/app
PYTHONPATH=/app/src

# MXOU 异步轮询 API Key（grsai.dakka.com.cn，仅用于轮询生图进度）
GRSAI_API_KEY=your_grsai_api_key

# API 限流（每 token 每分钟最大提交数）
RATE_LIMIT_PER_MINUTE=300

# 并发控制（同时执行 LangGraph 管线的任务数）
MAX_CONCURRENT=50

# 日志配置
LOG_FORMAT=json          # json=结构化JSON（生产），空=可读格式（本地）
LOG_LEVEL=INFO           # DEBUG/INFO/WARNING/ERROR
# LOG_FILE=/app/logs/worker.log  # 可选：同时写文件

# Sentry 错误监测（v0.23，可选；为空则禁用）
SENTRY_DSN=
SENTRY_ENV=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# 任务终态 webhook 通知（P1-4，可选；为空则不通知）
# 任务 completed/failed/rejected 落库后 fire-and-forget POST 终态摘要
# {task_id, status, product_summary, error_message, product_id, ozon_client_id}
# 任意支持 POST JSON 的 webhook 均可（Server酱示例格式）：
# TASK_NOTIFY_URL=https://sctapi.ftqq.com/<SendKey>.send

# PostgreSQL 容器配置
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
POSTGRES_DB=ozon
