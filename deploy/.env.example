# ─── Worker 环境变量模板 ───
# 复制为 .env 并填入实际值

# PostgreSQL 连接串（必填）
PGDATABASE_URL=postgresql://postgres:your_password@postgres:5432/ozon

# Supabase 鉴权（生产环境必填，本地可留空跳过鉴权）
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_service_role_key

# 应用配置
APP_WORKSPACE_PATH=/app
PYTHONPATH=/app/src

# WebUI 凭证加密主密钥（v0.41，WebUI 凭证管理功能必需；AES-256-GCM 加密 Ozon API Key）
# 生成：openssl rand -base64 32
# 未配置时凭证 CRUD 报错，其余页面不受影响；⚠️ 更换后历史凭证将无法解密（需重新创建）
CREDENTIAL_MASTER_KEY=your_base64_32_bytes_key

# WebUI 前端静态产物（v0.62.2 起随 worker 镜像多阶段内建, 固定 /app/webui/dist,
# 不再依赖宿主机 bind-mount; 无需在此覆盖。仅本机非 Docker 运行需要时设置）
# WEBUI_DIST=/path/to/webui/dist

# Docker 构建时 pip 源（v0.62.2 起默认阿里云; 国际/官方构建可显式覆盖为 pypi.org）
# PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/

# MXOU 异步轮询 API Key（grsai.dakka.com.cn，仅用于轮询生图进度）
GRSAI_API_KEY=your_grsai_api_key

# API 限流（每 token 每分钟最大提交数）
RATE_LIMIT_PER_MINUTE=300

# 并发控制（同时执行 LangGraph 管线的任务数）
MAX_CONCURRENT=50

# 日志配置
LOG_FORMAT=json          # json=结构化JSON（生产），空=可读格式（本地）
LOG_LEVEL=INFO           # DEBUG/INFO/WARNING/ERROR
# LOG_FILE=/app/logs/worker.log  # 可选：同时写文件

# Sentry 错误监测（v0.23，可选；为空则禁用）
SENTRY_DSN=
SENTRY_ENV=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# 任务终态 webhook 通知（P1-4，可选；为空则不通知）
# 任务 completed/failed/rejected 落库后 fire-and-forget POST 终态摘要
# {task_id, status, product_summary, error_message, product_id, ozon_client_id}
# 任意支持 POST JSON 的 webhook 均可（Server酱示例格式）：
# TASK_NOTIFY_URL=https://sctapi.ftqq.com/<SendKey>.send
# 低余额告警阈值（v0.62 R1，默认 50）：MXOU 余额 0 < balance < 阈值时按 token 30min
# 去重后 POST 到 TASK_NOTIFY_URL 通知用户充值；未配置 TASK_NOTIFY_URL 仅日志/Sentry 留痕。
# BALANCE_ALERT_THRESHOLD=50

# COS 图片转存/回源（可选；未配置则草稿图片镜像与生图兜底静默降级）
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-guangzhou
COS_PUBLIC_DOMAIN=

# 店铺同步调度（默认 1=任务化同步；0=回退旧版 15min 全局轮询，仅临时兜底）
STORE_SYNC_JOBS_ENABLED=1

# 店铺同步连续失败指数退避（v0.63.1；达到阈值后 2^(N-4) 分钟，上限 60min，成功清零）
STORE_SYNC_MAX_CONSECUTIVE_FAILURES=5
STORE_SYNC_MAX_BACKOFF_MINUTES=60

# 店铺数据硬删除入口（默认关闭；需管理端 + confirm=true，见 PRD M5）
ADMIN_HARD_DELETE_ENABLED=0

# PostgreSQL 容器配置
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
POSTGRES_DB=ozon
