# ─── Worker 环境变量模板 ───
# 复制为 .env 并填入实际值

# PostgreSQL 连接串（必填）
PGDATABASE_URL=postgresql://postgres:your_password@postgres:5432/ozon

# Supabase 鉴权（生产环境必填，本地可留空跳过鉴权）
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_service_role_key

# 应用配置
APP_WORKSPACE_PATH=/app
PYTHONPATH=/app/src

# MXOU 生图进度轮询（grsai.dakka.com.cn）
GRSAI_API_KEY=your_grsai_api_key

# API 限流（每 token 每分钟最大提交数）
RATE_LIMIT_PER_MINUTE=10

# 并发控制（同时执行 LangGraph 管线的任务数）
MAX_CONCURRENT=10

# 日志配置
LOG_FORMAT=json          # json=结构化JSON（生产），空=可读格式（本地）
LOG_LEVEL=INFO           # DEBUG/INFO/WARNING/ERROR
# LOG_FILE=/app/logs/worker.log  # 可选：同时写文件

# PostgreSQL 容器配置
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
POSTGRES_DB=ozon
