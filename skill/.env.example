# ─── Skill 环境变量模板 ───
# 复制为 .env 并填入实际值

# Worker 云端地址
WORKER_URL=https://worker.mxou.cn

# 1688 开放平台 Access Key（浏览器自动获取: python3 scripts/cli.py get_ak）
ALI_1688_AK=your_1688_ak_here

# Ozon 卖家后台 API 凭证（获取: https://seller.ozon.ru → API 设置）
OZON_CLIENT_ID=your_ozon_client_id
OZON_API_KEY=your_ozon_api_key

# MXOU API Token（用于 DeepSeek AI 翻译/属性匹配）
MXOU_TOKEN=your_mxou_token_here
