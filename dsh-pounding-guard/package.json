    }
  },
  "files": [
    "lib/index.js",
    "lib/index.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    }
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
